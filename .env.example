# Control plane (API, migrations) when run outside Docker Compose.
AEROCHORUS_DATABASE_URL=postgresql+psycopg://aerochorus:aerochorus@127.0.0.1:5432/aerochorus

# Integration tests (the Compose Postgres creates this database).
AEROCHORUS_TEST_DATABASE_URL=postgresql+psycopg://aerochorus:aerochorus@127.0.0.1:5432/aerochorus_test

# Optional host port overrides for docker compose.
# AEROCHORUS_PG_PORT=5432
# AEROCHORUS_API_PORT=8000

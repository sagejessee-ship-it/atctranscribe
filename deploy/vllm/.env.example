# deploy/vllm/.env (gitignored): per-host settings for the adjudicator model servers.
# Copy to .env next to compose.yml; docker compose reads it automatically.

# vLLM image tag (pinned; profiles were checked against this version).
VLLM_VERSION=v0.31.0
# GPUs for the server, as CUDA indexes: 0 for one GPU, 0,1 for h100-large (TP=2).
VLLM_GPUS=0
# Where the API listens. 127.0.0.1 when the runner is on this machine; the host's LAN
# address when a runner elsewhere (the audio host) calls it. No auth unless a key is set.
VLLM_BIND=127.0.0.1
VLLM_PORT=8100
# Hugging Face token (only for gated models or to avoid anonymous rate limits).
HF_TOKEN=
# Require this bearer key (the runner sends AEROCHORUS_ADJUDICATOR_API_KEY). Set it
# whenever VLLM_BIND is not 127.0.0.1.
AEROCHORUS_ADJUDICATOR_API_KEY=
# Model weights cache: a named volume by default, or a host path (e.g. /srv/models/hf).
# VLLM_CACHE=/srv/models/hf
# Extra vllm serve flags for this host only (e.g. --enforce-eager while debugging).
# VLLM_EXTRA_ARGS=

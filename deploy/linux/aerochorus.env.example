# /etc/aerochorus/aerochorus.env: EnvironmentFile for the AeroChorus systemd units.
# Secrets stay on this host; the browser never receives them.
AEROCHORUS_WORKER_CONFIG=/etc/aerochorus/worker.toml
AEROCHORUS_DATA=@DATA@
# CUDA 12 runtime for the pinned CrispASR build (from install-crispasr.sh).
LD_LIBRARY_PATH=@LD_LIBRARY_PATH@
# Review edge: LAN bind (no auth: trusted LAN only; do not port-forward).
AEROCHORUS_EDGE_HOST=0.0.0.0
AEROCHORUS_EDGE_PORT=8080
# Gemini adjudication runner (optional; OpenRouter):
# AEROCHORUS_OPENROUTER_API_KEY=

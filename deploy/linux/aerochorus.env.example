# /srv/aerochorus/config/aerochorus.env: settings and secrets for the containers (ADR-023).
# deploy.sh creates it from this template on the first run (random database password),
# then only updates AEROCHORUS_TAG. Keep it chmod 600. Browsers never see these values.

# Which images to run (set by deploy.sh from the bundle; do not edit by hand).
AEROCHORUS_TAG=@TAG@

# The host operator: AeroChorus containers run as this user (files stay theirs).
AEROCHORUS_UID=@UID@
AEROCHORUS_GID=@GID@

# Data root on this host and the read-only CIFS mount of the collector's archive.
AEROCHORUS_DATA=@DATA@
AEROCHORUS_CORPUS_MOUNT=@MOUNT@
TZ=America/New_York

# PostgreSQL (loopback only). Used when the data directory is first created.
POSTGRES_PASSWORD=@PGPASSWORD@

# Review web UI on the LAN (no authentication: trusted LAN only, never port-forward).
AEROCHORUS_EDGE_BIND=0.0.0.0
AEROCHORUS_EDGE_PORT=8080
# API: loopback. Set to this host's LAN address only for a remote worker.
AEROCHORUS_API_BIND=127.0.0.1

# Nightly backup into $AEROCHORUS_DATA/backups (copy it off this machine regularly).
AEROCHORUS_BACKUP_HOUR=3
AEROCHORUS_BACKUP_KEEP_DAYS=14

# --- optional: on-demand ADS-B context (ADR-020, docs/context/OPENSKY_PROVIDER.md) ---
# Trino (historical state vectors) once OpenSky grants access:
AEROCHORUS_OPENSKY_USERNAME=
AEROCHORUS_OPENSKY_PASSWORD=
# REST API client (account page -> API client), used while Trino is unavailable:
AEROCHORUS_OPENSKY_CLIENT_ID=
AEROCHORUS_OPENSKY_CLIENT_SECRET=
AEROCHORUS_ADSB_PROVIDER=auto

# --- optional, paid: model adjudication (ADR-022) ---
# 1 = run the adjudicator container. It works only on batches a human confirmed in the
# review UI under a cost cap, and is the only place the OpenRouter key is used.
AEROCHORUS_ADJUDICATOR=0
AEROCHORUS_OPENROUTER_API_KEY=
AEROCHORUS_ADJUDICATION_MAX_BATCH_USD=25

# AeroChorus worker on the Linux GTX 1070 host (ADR-021). Generated by
# deploy/linux/setup.sh from deploy/linux/worker.linux.toml.template.

worker_name = "@WORKER_NAME@"
api_url = "http://127.0.0.1:8000"
# Qualification applies per hardware profile (never a hostname).
hardware_profile = "linux_pascal_8gb"

heartbeat_interval_seconds = 30
incremental_scan_interval_seconds = 900
full_scan_interval_seconds = 86400
read_concurrency = 4
observation_batch_size = 500
# Queued sweeps are processed; none exist until someone creates one (no auto backlog).
process_sweeps = true

# Logical source -> read-only network mount of the collector's archive.
[sources.@SOURCE_KEY@]
root = "@MOUNT@"
auto_scan = true

# The ATCO2 benchmark clips (AeroChorus-derived, copied during migration).
# [sources.atco2_fixed]
# root = "@DATA@/corpora/atco2_fixed"

[transcription]
models_dir = "@DATA@/models"
artifact_root = "@DATA@/artifacts"
artifact_store = "linux1070"
# Raw responses recorded on the Windows dev box, copied during migration (read-only).
artifact_mounts = { jesseepc = "@DATA@/artifacts-jesseepc" }
lease_seconds = 900
pending_batch = 25
auto_pull_models = false

[transcription.crispasr]
launcher = "native"
binary = "@CRISPASR_BINARY@"
host_port = 8090
startup_timeout_seconds = 900
request_timeout_seconds = 600
# CUDA 12 runtime for the pinned binary (libcudart.so.12 / libcublas.so.12).
env = { LD_LIBRARY_PATH = "@LD_LIBRARY_PATH@" }

# Per-model memory/offload on 8 GB VRAM. Escalate only as far as needed, in order:
# quantized weights -> quantized KV -> partial layer residency -> KV on CPU -> CPU.
# Every setting here is recorded with each run and in qualification results.
# [transcription.model_runtime."voxtral-mini-4b-realtime-q4_k"]
# strategy = "kv-q8"
# env = { CRISPASR_KV_QUANT = "q8_0" }
# [transcription.model_runtime."canary-qwen-2.5b-q4_k"]
# strategy = "offload-24-layers"
# env = { CRISPASR_N_GPU_LAYERS = "24", CRISPASR_KV_ON_CPU = "1" }
